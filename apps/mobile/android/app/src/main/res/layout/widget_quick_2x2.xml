<?xml version="1.0" encoding="utf-8"?>
<!--
  2x2 组件：只有 4 个快捷操作的 2×2 四宫格。

  稿是 320×320 方形卡片，2×2 格位在真机上约 155×155dp。除了这 4 格不显示任何
  东西——不出现电量、里程、车图、时间或状态徽章。

  RemoteViews 只允许 inflate 带 @RemoteView 注解的类，`View` 与 `Space` 都不在其
  中（会抛 "Class not allowed to be inflated"），所以格间距一律用 layout_margin。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_card_bg"
    android:padding="@dimen/widget_card_padding">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:layout_marginBottom="@dimen/widget_tile_gap">
        <LinearLayout
            android:id="@+id/widget_slot_0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="0dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_tile_bg"
            android:padding="6dp">

            <FrameLayout
                android:layout_width="@dimen/widget_icon_circle"
                android:layout_height="@dimen/widget_icon_circle"
                android:layout_marginBottom="4dp"
                android:background="@drawable/widget_icon_circle_bg">

                <ImageView
                    android:id="@+id/widget_icon_0"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/widget_icon_light_0"
                    android:contentDescription="@null" />
            </FrameLayout>

            <TextView
                android:id="@+id/widget_label_0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/widget_value"
                android:textSize="@dimen/widget_tile_label_size"
                android:fontFamily="@font/plus_jakarta_sans" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/widget_slot_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/widget_tile_gap"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_tile_bg"
            android:padding="6dp">

            <FrameLayout
                android:layout_width="@dimen/widget_icon_circle"
                android:layout_height="@dimen/widget_icon_circle"
                android:layout_marginBottom="4dp"
                android:background="@drawable/widget_icon_circle_bg">

                <ImageView
                    android:id="@+id/widget_icon_1"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/widget_icon_light_1"
                    android:contentDescription="@null" />
            </FrameLayout>

            <TextView
                android:id="@+id/widget_label_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/widget_value"
                android:textSize="@dimen/widget_tile_label_size"
                android:fontFamily="@font/plus_jakarta_sans" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:baselineAligned="false">
        <LinearLayout
            android:id="@+id/widget_slot_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="0dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_tile_bg"
            android:padding="6dp">

            <FrameLayout
                android:layout_width="@dimen/widget_icon_circle"
                android:layout_height="@dimen/widget_icon_circle"
                android:layout_marginBottom="4dp"
                android:background="@drawable/widget_icon_circle_bg">

                <ImageView
                    android:id="@+id/widget_icon_2"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/widget_icon_light_2"
                    android:contentDescription="@null" />
            </FrameLayout>

            <TextView
                android:id="@+id/widget_label_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/widget_value"
                android:textSize="@dimen/widget_tile_label_size"
                android:fontFamily="@font/plus_jakarta_sans" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/widget_slot_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/widget_tile_gap"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_tile_bg"
            android:padding="6dp">

            <FrameLayout
                android:layout_width="@dimen/widget_icon_circle"
                android:layout_height="@dimen/widget_icon_circle"
                android:layout_marginBottom="4dp"
                android:background="@drawable/widget_icon_circle_bg">

                <ImageView
                    android:id="@+id/widget_icon_3"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/widget_icon_light_3"
                    android:contentDescription="@null" />
            </FrameLayout>

            <TextView
                android:id="@+id/widget_label_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/widget_value"
                android:textSize="@dimen/widget_tile_label_size"
                android:fontFamily="@font/plus_jakarta_sans" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

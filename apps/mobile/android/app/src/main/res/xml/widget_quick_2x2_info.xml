<?xml version="1.0" encoding="utf-8"?>
<!--
  2x2：2×2 格位（约 180dp 见方）

  minWidth/minHeight 是 launcher 分配格位的依据，必须与 targetCell 一致：
  早期只写了 targetCell 而 minWidth 偏小，桌面按最小尺寸给了 1 列宽的窄条，
  四格标签全被截成「远…」「开…」（Pixel 4a / Android 13 实测）。
  updatePeriodMillis 置 0：2x2 与 1x4 没有读数，2x4 的刷新由 App 主动推送。
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:resizeMode="none"
    android:initialLayout="@layout/widget_quick_2x2"
    android:previewLayout="@layout/widget_quick_2x2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:description="@string/widget_desc_2x2" />
